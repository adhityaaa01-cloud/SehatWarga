# Development only. Replace placeholders locally; never commit .env.
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/sehatwarga
AI_PROVIDER=fallback
AI_API_KEY=
AI_MODEL=
# To enable Gemini: AI_PROVIDER=gemini, AI_API_KEY=your-private-key,
# AI_MODEL=a-supported-model-from-your-Gemini-account
